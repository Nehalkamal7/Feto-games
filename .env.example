# ========================================================
# FETO GAMES - ENVIRONMENT VARIABLES
# Copy this file to .env for local development
# ========================================================

# General Configuration
NODE_ENV=development
APP_NAME="FETO GAMES"
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:4000
SERVER_PORT=4000

# PostgreSQL Database (Prisma ORM)
POSTGRES_USER=feto_admin
POSTGRES_PASSWORD=feto_super_secret_pass_2026
POSTGRES_DB=feto_games_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://feto_admin:feto_super_secret_pass_2026@localhost:5432/feto_games_db?schema=public

# Redis (Room state, matchmaking, session reconnect tokens, Socket.IO adapter)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=feto_redis_secure_pass_2026
REDIS_URL=redis://:feto_redis_secure_pass_2026@localhost:6379

# Session & JWT Reconnect Token Secrets
JWT_SECRET=feto_games_jwt_reconnection_secret_super_key_32chars!
JWT_RECONNECT_EXPIRY_SECONDS=300
GRACE_PERIOD_SECONDS=45

# Room & Lobby Limits
MAX_PLAYERS_PER_ROOM=15
MIN_PLAYERS_TO_START=2
ROOM_CODE_LENGTH=6
ROOM_IDLE_TIMEOUT_SECONDS=1800

# Next.js Public Vars (accessible on browser)
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME="FETO GAMES"
NEXT_PUBLIC_MAX_ROOM_PLAYERS=15
