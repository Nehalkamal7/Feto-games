# ========================================================
# FETO GAMES - ENVIRONMENT VARIABLES (VERCEL SERVERLESS ARCHITECTURE)
# ========================================================

# General Configuration
NODE_ENV=development
APP_NAME="FETO GAMES"
NEXT_PUBLIC_APP_NAME="FETO GAMES"
NEXT_PUBLIC_MAX_ROOM_PLAYERS=15

# ========================================================
# 1. Serverless Realtime Multiplayer (Ably Realtime + Upstash Redis)
# Runs 100% natively on Vercel Serverless API Routes
# ========================================================
# Ably Realtime Server Key (Used in /api/ably/auth and /lib/ably-server.ts)
ABLY_API_KEY=your_ably_api_key_here

# Upstash Redis REST API (Edge & Serverless state storage with automatic TTL)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-rest-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Room & Lobby Limits
MAX_PLAYERS_PER_ROOM=15
MIN_PLAYERS_TO_START=2
ROOM_CODE_LENGTH=6
ROOM_IDLE_TIMEOUT_SECONDS=7200

# Optional Database & Legacy Docker Local Dev (if running PostgreSQL locally)
POSTGRES_USER=feto_admin
POSTGRES_PASSWORD=feto_super_secret_pass_2026
POSTGRES_DB=feto_games_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://feto_admin:feto_super_secret_pass_2026@localhost:5432/feto_games_db?schema=public
