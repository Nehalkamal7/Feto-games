{
  "name": "feto-games",
  "version": "1.0.0",
  "description": "FETO GAMES - Production-ready, real-time multiplayer party gaming platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@feto-games/web",
    "dev:web": "npm run dev --workspace=@feto-games/web",
    "build": "npm run build --workspace=@feto-games/web",
    "build:web": "npm run build --workspace=@feto-games/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspace=@feto-games/web",
    "test:simulation": "tsx scripts/simulate-15-players.ts",
    "postinstall": "node scripts/patch-ably.js"
  },
  "keywords": [
    "multiplayer",
    "socket.io",
    "redis",
    "nextjs",
    "party-games",
    "feto-games"
  ],
  "author": "FETO Games Team",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
